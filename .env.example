# =============================================================================
# ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to `.env` before running the project:
#     cp .env.example .env
#
# ⚠️ IMPORTANT:
# - Replace placeholder values with your own credentials.
# - Never commit your real `.env` file to Git.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# You can optionally change the database name, user, and password to match your
# local or Docker setup. These values are read by both the app and docker-compose.

POSTGRES_DB=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
PGDATA=/var/lib/postgresql/data

# -----------------------------------------------------------------------------
# API KEYS / SECRETS
# -----------------------------------------------------------------------------
# 🔑 MAPBOX_TOKEN:
#   Required for displaying interactive maps in Streamlit.
#   You can obtain your own token by signing up at:
#   → https://account.mapbox.com/
#
#   Example:
#   MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJjazU4M3h0czYwMDA0M2RsbGZ4MHR0cTFuIn0.abc123

MAPBOX_TOKEN=

# -----------------------------------------------------------------------------
# EXTRACTOR CONFIGURATION
# -----------------------------------------------------------------------------

MONTHS_BEFORE_CURRENT=12          # how many full months before current to load
REQUEST_TIMEOUT_SECONDS=10        # HTTP timeout per request
REQUEST_SLEEP_SECONDS=0.2         # polite delay between requests
MAX_SPLIT_RETRIES=3              # cap recursive splits to avoid loops